# SmartSpace AI - Frontend Environment Variables
# In production (Render/Vercel/Netlify), set VITE_API_BASE_URL to your deployed FastAPI backend HTTPS URL.
# Example: https://smartspace-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8001

# Optional: Google Maps API key for showroom locator
VITE_GOOGLE_MAPS_API_KEY=
