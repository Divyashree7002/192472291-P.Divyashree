# SmartSpace AI - Backend Environment Variables Example
# Port automatically assigned by Render, default 8001 for local execution
PORT=8001
HOST=0.0.0.0

# Frontend URL(s) for CORS authorization (comma-separated if multiple)
# In production, set to your deployed frontend URL, e.g. https://smartspaceai.onrender.com
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Secret key for JWT token signing in production (generate a strong random string)
SMARTSPACE_JWT_SECRET=change-this-to-a-secure-random-secret-in-production-2026

# SQLite database file path (optional, default: ./smartspace.db)
# If using a Render Persistent Disk mounted at /data, set to: /data/smartspace.db
SMARTSPACE_DB_PATH=smartspace.db

# Default administrative and researcher seed credentials
INITIAL_ADMIN_EMAIL=admin@smartspace.ai
INITIAL_ADMIN_PASSWORD=Admin@12345

INITIAL_RESEARCH_EMAIL=research@smartspace.ai
INITIAL_RESEARCH_PASSWORD=Research@SmartSpace2026!

INITIAL_USER_EMAIL=user@smartspace.ai
INITIAL_USER_PASSWORD=User@SmartSpace2026!
